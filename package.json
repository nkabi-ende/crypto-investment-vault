{
  "name": "civ-cloudflare",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply civ-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply civ-db --remote",
    "typecheck": "tsc",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run typecheck && npm test",
    "test:smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "@playwright/test": "^1.58.2",
    "@types/node": "^22.20.5",
    "esbuild": "0.28.2",
    "miniflare": "5.20261116.0-beta",
    "typescript": "^5.7.0",
    "wrangler": "^4.45.0"
  }
}
